# Build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
**/__pycache__/
**/*.pyc
**/*.pyo

# Training runs, vendored tools, root pretrained weights (reproducible/large)
runs/
tools/
/*.pt

# Models (download separately, large files)
models/*.engine
models/*.onnx
models/*.pt
models/*.safetensors
models/*.bin
!models/.gitkeep
!models/README.md
# keep trained models (small, valuable, not trivially reproducible)
# cube*/wide* = 우리가 학습한 것(백업), FastSAM-s/yolov8s-world = 재다운로드 가능(제외)
!models/cube*.pt
!models/wide*.pt

# Data (raw recordings, bag files)
data/**
!data/.gitkeep
!data/README.md

# Logs
logs/**
!logs/.gitkeep

# IDE/editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python venvs
.venv/
venv/

# Secrets / local config
.env
*.local.yaml

*.zip
